# Server
PORT=4000
NODE_ENV=development

# Stellar network: testnet | mainnet | futurenet
STELLAR_NETWORK=testnet

# Contract ID of the deployed wallet contract (demo contract on testnet)
CONTRACT_ID=CDEMOCONTRACTIDPLACEHOLDER0000000000000000000000000000000000

# JWT signing secret for Bearer tokens issued by POST /api/v1/auth/login
# (and httpOnly cookie sessions). Use a long random value in production.
JWT_SECRET=change-me-in-production

# Lifetime of issued access tokens (e.g. 15m, 1h)
JWT_EXPIRES_IN=15m

# CORS: comma-separated list of allowed origins for the web app
CORS_ORIGINS=http://localhost:3000

# NOTE: The legacy shared-secret `x-api-key` authentication pattern has been
# removed. All protected routes now require per-user auth via
# POST /api/v1/auth/login and Bearer tokens (or httpOnly cookie sessions).
